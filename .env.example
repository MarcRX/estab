# Copy to .env and replace all placeholder values before deploying.
# Never commit .env to version control.

# --- Application ---
APP_ENV=local
APP_DEBUG=1
APP_SECRET=change-me-to-a-long-random-string

# --- MariaDB 11.4 LTS ---
# Keep these aligned with kats/4fcfg/dbcfg.inc.php and kats/4fcfg/e_cfg.inc.php.
MARIADB_ROOT_PASSWORD=change-me-root-password-min-32-chars
MARIADB_DATABASE=152119jun2026
MARIADB_USER=estabuser
MARIADB_PASSWORD=change-me-app-password-min-32-chars
MARIADB_PORT=3306

# Host name of the MariaDB service on the Compose network.
ESTAB_DB_HOST=mariadb

# --- PHP-FPM ---
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=32M
PHP_POST_MAX_SIZE=32M
PHP_MAX_EXECUTION_TIME=60
PHP_TIMEZONE=Europe/Berlin

# uid/gid of the host user that owns the web files (id -u / id -g).
WWW_UID=501
WWW_GID=20

# --- Nginx ---
HTTP_PORT=80
NGINX_SERVER_NAME=localhost
NGINX_CLIENT_MAX_BODY_SIZE=32m

# --- TLS (optional: mount certs into docker/certs/) ---
# TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
# TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
